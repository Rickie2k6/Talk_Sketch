VITE_HOST=0.0.0.0
# Optional: override the Vite dev port. If omitted, Vite uses its normal default and
# will choose another port automatically if needed.
# VITE_PORT=5173

# Optional: override the backend target instead of using ../backend/.backend-port.
# VITE_BACKEND_URL=http://127.0.0.1:8080

# Optional: explicit collaboration server URL for LAN devices.
# Example: VITE_COLLAB_SERVER_URL=http://10.204.118.200:8099
